# Supabase 연결 정보
# .env.local 파일을 별도로 만들어 채워 주세요 (gitignore 대상)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 광고 환경 설정
# test        → Toss Ads 테스트 전용 광고 ID 사용 (ait-ad-test-rewarded-id)
# production  → 실제 발급된 프로덕션 광고 ID 사용 (ait.v2.live.*)
# 미설정       → 개발 빌드(vite dev)이면 test, 프로덕션 빌드(vite build)이면 production 자동 적용
VITE_AD_ENV=test

# Supabase 서비스 롤 키 (브라우저에 노출 금지! 마이그레이션 스크립트 전용)
# 발급 위치: Supabase Dashboard → Project Settings → API → service_role Key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
