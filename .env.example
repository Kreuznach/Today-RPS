# Supabase 연결 정보
# .env.local 파일을 별도로 만들어 채워 주세요 (gitignore 대상)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase 서비스 롤 키 (브라우저에 노출 금지! 마이그레이션 스크립트 전용)
# 발급 위치: Supabase Dashboard → Project Settings → API → service_role Key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
